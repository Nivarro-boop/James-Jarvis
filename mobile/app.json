{
  "expo": {
    "name": "James",
    "slug": "james-jarvis-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05080c",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "dev.void.jarvis.phone",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "James hört zu, solange du die Sprechtaste hältst.",
        "NSLocalNetworkUsageDescription": "James verbindet sich mit deinem Rechner im Heimnetz und weckt ihn bei Bedarf auf.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Zum Scannen des Kopplungs-QR-Codes vom Rechner.",
          "microphonePermission": "James hört zu, solange du die Sprechtaste hältst.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05080c"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "dev.void.jarvis.phone.watch",
                  "targetName": "JamesWatch"
                }
              ]
            }
          }
        },
        "projectId": "d94e23c5-6e21-41a6-bed7-f2f3cd7496a7"
      }
    },
    "owner": "fabioxx"
  }
}
